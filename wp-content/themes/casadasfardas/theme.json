{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1360px"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{
					"slug": "navy",
					"name": "Azul Casa das Fardas",
					"color": "#003B71"
				},
				{
					"slug": "navy-deep",
					"name": "Azul profundo",
					"color": "#021B36"
				},
				{
					"slug": "amber",
					"name": "Âmbar (ação)",
					"color": "#F3B235"
				},
				{
					"slug": "amber-soft",
					"name": "Âmbar suave",
					"color": "#FDF3DC"
				},
				{
					"slug": "ink",
					"name": "Grafite",
					"color": "#16202B"
				},
				{
					"slug": "muted",
					"name": "Texto secundário",
					"color": "#5A6573"
				},
				{
					"slug": "line",
					"name": "Linha",
					"color": "#DDE2E8"
				},
				{
					"slug": "surface",
					"name": "Superfície",
					"color": "#F4F5F7"
				},
				{
					"slug": "paper",
					"name": "Branco",
					"color": "#FFFFFF"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Bricolage Grotesque",
					"fontFamily": "\"Bricolage Grotesque\", \"Inter\", system-ui, sans-serif"
				},
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Pequeno",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Normal",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Grande",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Destaque",
					"size": "1.75rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Título",
					"size": "2.75rem",
					"fluid": {
						"min": "1.875rem",
						"max": "2.75rem"
					}
				},
				{
					"slug": "display",
					"name": "Expressivo",
					"size": "4.5rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"%"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "clamp(2rem, 1.5rem + 2vw, 3rem)"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "clamp(3rem, 2rem + 4vw, 5rem)"
				},
				{
					"slug": "70",
					"name": "XXL",
					"size": "clamp(4rem, 2.5rem + 6vw, 7.5rem)"
				}
			],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"border": {
			"radius": false,
			"color": false,
			"style": false,
			"width": false
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": false
				}
			},
			"core/image": {
				"lightbox": {
					"allowEditing": false
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(16px, 3vw, 40px)",
				"right": "clamp(16px, 3vw, 40px)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.08",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--navy-deep)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "1.02"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.2"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.3"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--navy-deep)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--amber)",
					"text": "var(--wp--preset--color--navy-deep)"
				},
				"typography": {
					"fontWeight": "650",
					"fontSize": "1rem",
					"lineHeight": "1.2"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "1.4rem",
						"right": "1.4rem"
					}
				},
				":hover": {
					"color": {
						"background": "#E5A01C",
						"text": "var(--wp--preset--color--navy-deep)"
					}
				}
			}
		}
	}
}
