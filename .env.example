# Copiar para .env e ajustar. Não colocar segredos reais neste ficheiro de exemplo.
DB_PASSWORD=cdf-local
WP_PORT=8092
MAILPIT_PORT=8028
CDF_DOMAIN=casadasfardas.localhost
# staging: noindex, gateway de teste disponível, emails capturados. production: só após a checklist de lançamento.
WP_ENVIRONMENT_TYPE=staging
# SMTP: em local o Mailpit captura tudo. Em produção, configurar o servidor real (credenciais fora do repositório).
CDF_SMTP_HOST=mailpit
CDF_SMTP_PORT=1025
